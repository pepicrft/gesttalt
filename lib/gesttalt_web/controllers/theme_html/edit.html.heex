<Layouts.app flash={@flash} current_scope={@current_scope} admin admin_theme={@admin_theme}>
  <div id="admin-theme" data-theme={@active_built_in_theme || "custom"}>
    <header id="page-heading">
      <p data-part="eyebrow">Design</p><h1 data-part="title">Theme</h1><p data-part="description">
        Choose a built-in starting point for your publication. It remains inherited until you or your agent customize it.
      </p>
    </header>
    <section data-part="built-in-themes" aria-labelledby="built-in-themes-title">
      <div data-part="section-heading">
        <p data-part="eyebrow">Built-in themes</p><h2 id="built-in-themes-title">
          Choose a point of view
        </h2><p>
          Changing a theme replaces any current site-owned theme with the selected built-in design.
        </p>
      </div>
      <div data-part="theme-grid">
        <article
          :for={built_in_theme <- @built_in_themes}
          id={"built-in-theme-#{built_in_theme.id}"}
          data-part="theme-card"
          data-theme={built_in_theme.id}
          data-selected={to_string(@active_built_in_theme == built_in_theme.id)}
        >
          <div data-part="preview" aria-hidden="true" style={built_in_theme.preview_style}>
            <span data-part="preview-title">{built_in_theme.name}</span><span data-part="preview-rule"></span><span data-part="preview-lines"></span>
          </div>
          <div data-part="content">
            <div>
              <h3>{built_in_theme.name}</h3><p>{built_in_theme.description}</p>
            </div>
            <form action={~p"/admin/theme"} method="post" data-preserve-scroll>
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} /><input
                type="hidden"
                name="built_in_theme"
                value={built_in_theme.id}
              />
              <button class={
                if @active_built_in_theme == built_in_theme.id,
                  do: "button",
                  else: "button button--primary"
              }>
                {if @active_built_in_theme == built_in_theme.id,
                  do: "Selected",
                  else: "Choose theme"}
              </button>
            </form>
          </div>
        </article>
      </div>
      <p :if={is_nil(@active_built_in_theme)} data-part="custom-theme-note">
        <strong>Custom theme active.</strong>
        Choosing a built-in theme replaces its templates, styles, and variables.
      </p>
    </section>
    <section class="panel" data-part="agent-workflow">
      <div data-part="workflow-copy">
        <p data-part="eyebrow">Agent workflow</p><h2>Edit without moving theme files around</h2><p>
          Connect your agent to the
          <a href="https://modelcontextprotocol.io/">Model Context Protocol</a>
          endpoint at <code>/mcp</code>. The agent can create an isolated editing session and give you its preview address.
        </p>
      </div>
      <ol data-part="steps">
        <li>
          <strong>Create a session.</strong>
          The active <span data-part="theme-name">{@theme.name}</span>
          theme becomes a durable draft that survives application deployments.
        </li>
        <li>
          <strong>Open the preview.</strong>
          Keep it beside your agent conversation. A live editing sign stays visible while Phoenix LiveView refreshes the publication after every accepted edit. Navigate between published pages normally. The editing session reports the current page for every connected preview.
        </li>
        <li>
          <strong>Share the view when useful.</strong>
          Select <em>Allow screenshots</em>
          and choose the preview tab. Your agent can then request an image of that exact browser view until you stop sharing or end the editing session.
        </li>
        <li>
          <strong>Publish or discard.</strong>
          Publishing persists exactly what you previewed. Discarding immediately restores the published theme in the same preview.
        </li>
      </ol>
      <p>
        Start with the standard color, typography, spacing, radius, size, and shadow variables, adapted from the <a href="https://theme-ui.com/theme-spec">Theme UI (user interface) theme specification</a>.
        Edit Liquid only when the home, article, page, or photography structure needs to change.
      </p>
      <a class="button button--primary" href={~p"/docs#themes"}>Read the theme editing guide</a>
    </section>
  </div>
</Layouts.app>
