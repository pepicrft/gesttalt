<Layouts.app flash={@flash} current_scope={@current_scope} admin>
  <div id="admin-settings">
    <header id="page-heading">
      <p data-part="eyebrow">Publication</p><h1 data-part="title">Settings</h1><p data-part="description">
        Personalize the publication and map verified domains to this account.
      </p>
    </header>
    <.form
      :let={form}
      for={@site_changeset}
      action={~p"/admin/settings"}
      method="put"
      class="panel"
      data-part="publication-form"
    >
      <div class="field" data-part="field">
        <label for={form[:name].id}>Name</label><input
          id={form[:name].id}
          name={form[:name].name}
          value={form[:name].value}
        />
      </div>
      <div class="field" data-part="field">
        <label for={form[:tagline].id}>Tagline</label><input
          id={form[:tagline].id}
          name={form[:tagline].name}
          value={form[:tagline].value}
        />
      </div>
      <button class="button button--primary">Save publication</button>
    </.form>
    <section id="settings-list">
      <h2 data-part="title">Domains</h2>
      <article
        :for={domain <- @domains}
        id={"domain-row-#{domain.id}"}
        data-part="row"
        data-domain-status={domain.status}
      >
        <div data-part="content">
          <strong>{domain.hostname}</strong><span data-part="status" data-status={domain.status}>{domain.status}</span><p
            :if={domain.status == :pending}
            data-part="description"
          >
            Add both records below, wait for them to propagate, then verify the domain.
          </p><ol :if={domain.status == :pending} data-part="domain-setup">
            <li>
              <strong>Verify ownership</strong><p>
                Add a
                <a href="https://developers.cloudflare.com/dns/manage-dns-records/reference/dns-record-types/#txt">Text (TXT) record</a>
                at <code>_gesttalt.{domain.hostname}</code>
                with <code>gesttalt-domain={domain.verification_token}</code>.
              </p>
            </li><li>
              <strong>Route traffic</strong><p>
                Point <code>{domain.hostname}</code>
                to <code>{@custom_domain_target}</code>
                with a <a href="https://developers.cloudflare.com/dns/manage-dns-records/reference/dns-record-types/#cname">Canonical Name (CNAME) record</a>.
                Disable proxying until setup finishes.
              </p><p :if={@custom_domain_ipv4_addresses != []}>
                If your provider does not allow that record on a root domain, use an
                <a href="https://developers.cloudflare.com/dns/manage-dns-records/reference/dns-record-types/#a-and-aaaa">Address (A) record</a>
                for each of these addresses: <code>{Enum.join(@custom_domain_ipv4_addresses, ", ")}</code>.
              </p>
            </li>
          </ol>
        </div><div data-part="actions">
          <form
            :if={domain.status == :pending}
            action={~p"/admin/domains/#{domain}/verify"}
            method="post"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} /><button class="button">Verify</button>
          </form><form
            :if={domain.kind == :custom}
            action={~p"/admin/domains/#{domain}"}
            method="post"
          >
            <input type="hidden" name="_method" value="delete" /><input
              type="hidden"
              name="_csrf_token"
              value={get_csrf_token()}
            /><button class="link-button">Remove</button>
          </form>
        </div>
      </article>
      <form action={~p"/admin/domains"} method="post" class="inline-form" data-part="add-form">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} /><label for="hostname">Custom domain</label><input
          id="hostname"
          name="domain[hostname]"
          placeholder="notes.example.com"
          required
        /><button class="button">Add domain</button>
      </form>
    </section>
  </div>
</Layouts.app>
