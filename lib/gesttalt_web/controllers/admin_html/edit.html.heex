<Layouts.app flash={@flash} current_scope={@current_scope} admin admin_theme={@admin_theme}>
  <div id="admin-post-editor">
    <header id="page-heading">
      <p data-part="eyebrow">Publishing desk</p>
      <h1 data-part="title">{@page_title}</h1>
      <p data-part="description">
        Markdown is supported. The slug becomes the post's permanent address.
      </p>
    </header>

    <.form
      :let={form}
      for={@changeset}
      action={@form_action}
      method={@form_method}
      data-part="form"
    >
      <div class="field" data-part="field">
        <label for={form[:title].id}>Title</label>
        <input
          type="text"
          id={form[:title].id}
          name={form[:title].name}
          value={form[:title].value}
          autofocus
          required
        />
        <p :for={error <- form[:title].errors} class="field-error">{translate_error(error)}</p>
      </div>

      <div class="field" data-part="field">
        <label for={form[:slug].id}>Slug</label>
        <input
          type="text"
          id={form[:slug].id}
          name={form[:slug].name}
          value={form[:slug].value}
          placeholder="generated-from-the-title"
        />
        <p :for={error <- form[:slug].errors} class="field-error">{translate_error(error)}</p>
      </div>

      <div class="field" data-part="field">
        <label for={form[:excerpt].id}>Excerpt</label>
        <textarea
          id={form[:excerpt].id}
          name={form[:excerpt].name}
          rows="3"
          placeholder="A concise introduction for the index and feed."
        >{form[:excerpt].value}</textarea>
        <p :for={error <- form[:excerpt].errors} class="field-error">{translate_error(error)}</p>
      </div>

      <div class="field" data-part="field">
        <label for={form[:body].id}>Article</label>
        <textarea
          id={form[:body].id}
          name={form[:body].name}
          rows="22"
          class="editor-body"
          required
        >{form[:body].value}</textarea>
        <p :for={error <- form[:body].errors} class="field-error">{translate_error(error)}</p>
      </div>

      <div class="form-grid" data-part="field-grid">
        <div class="field" data-part="field">
          <label for={form[:kind].id}>Type</label>
          <select id={form[:kind].id} name={form[:kind].name}><option
            value="post"
            selected={to_string(form[:kind].value || :post) == "post"}
          >
            Post
          </option><option value="page" selected={to_string(form[:kind].value) == "page"}>
            Page
          </option></select>
        </div>
        <div class="field" data-part="field">
          <label for={form[:status].id}>Status</label>
          <select id={form[:status].id} name={form[:status].name}>
            <option value="draft" selected={to_string(form[:status].value || :draft) == "draft"}>
              Draft
            </option>
            <option value="published" selected={to_string(form[:status].value) == "published"}>
              Published
            </option>
          </select>
        </div>
        <div class="field" data-part="field">
          <label for={form[:published_at].id}>Publish at</label>
          <input
            type="datetime-local"
            id={form[:published_at].id}
            name={form[:published_at].name}
            value={datetime_value(@changeset)}
          />
        </div>
      </div>

      <div class="form-actions" data-part="actions">
        <button class="button button--primary" type="submit">Save post</button>
        <a class="button" href={~p"/admin/"}>Cancel</a>
      </div>
    </.form>

    <section :if={@post.id} data-part="danger-zone">
      <h2>Delete post</h2>
      <p>This cannot be undone.</p>
      <form action={~p"/admin/posts/#{@post}"} method="post">
        <input type="hidden" name="_method" value="delete" />
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <button class="button button--danger" type="submit">Delete</button>
      </form>
    </section>
  </div>
</Layouts.app>
