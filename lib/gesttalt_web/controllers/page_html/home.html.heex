<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="marketing-home">
    <section data-part="hero">
      <p data-part="eyebrow">{dgettext("marketing", "Agent-native publishing")}</p>
      <h1 data-part="title">
        {dgettext("marketing", "A blog your agents can run. A publication you own.")}
      </h1>
      <p data-part="description">
        {dgettext(
          "marketing",
          "Ask an agent to create your account, write and publish content, manage media and domains, or reshape the theme in a live preview. Gesttalt was designed for the whole conversation."
        )}
      </p>
      <div data-part="actions">
        <a class="button button--primary" href={~p"/users/register"}>{dgettext(
          "marketing",
          "Start publishing"
        )}</a><a href={~p"/docs#agent-registration"}>{dgettext(
          "marketing",
          "Connect an agent →"
        )}</a>
      </div>
    </section>
    <section data-part="features">
      <article data-part="feature">
        <span data-part="index">01</span><h2 data-part="title">Start through a conversation</h2><p data-part="description">
          An agent can register with your email, then hand you a short confirmation code. You sign in on Gesttalt and stay in control of the credential.
        </p>
      </article>
      <article data-part="feature">
        <span data-part="index">02</span><h2 data-part="title">Manage the whole publication</h2><p data-part="description">
          Create, schedule, publish, and delete content. Upload media, edit themes, and connect domains and applications without leaving the agent.
        </p>
      </article>
      <article data-part="feature">
        <span data-part="index">03</span><h2 data-part="title">
          Keep human approval in the loop
        </h2><p data-part="description">
          Secure registration binds the agent to your account without sharing a password. Publishing, deletion, domains, and credentials remain explicit decisions.
        </p>
      </article>
    </section>
    <section data-part="manifesto">
      <p data-part="eyebrow">Themes are code</p><h2 data-part="title">
        Design the publication in the same conversation that runs it.
      </h2><p data-part="description">
        Standard design variables, Liquid route templates, and vanilla Cascading Style Sheets give agents a precise editing surface. Keep the live preview beside the conversation and publish the isolated draft only when it feels right.
      </p><a href={~p"/docs#themes"}>Read the theme guide →</a>
    </section>
  </div>
</Layouts.app>
