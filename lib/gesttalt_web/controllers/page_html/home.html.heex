<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="marketing-home">
    <section data-part="hero">
      <p data-part="eyebrow">{dgettext("marketing", "Independent publishing")}</p>
      <h1 data-part="title">
        {dgettext("marketing", "A simple blogging platform for the agentic world.")}
      </h1>
      <p data-part="description">
        {dgettext(
          "marketing",
          "Your words, your address, everywhere. Publish from the web, an application, an automation, or an agent."
        )}
      </p>
      <div data-part="actions">
        <a class="button button--primary" href={~p"/users/register"}>{dgettext(
          "marketing",
          "Start publishing"
        )}</a><a href={~p"/docs"}>{dgettext(
          "marketing",
          "Explore the publishing interfaces →"
        )}</a>
      </div>
      <p data-part="plan-note">
        {dgettext(
          "marketing",
          "Publish text for free from the web, an application, or an agent. Upgrade for €5 per month when you need a custom domain, images, or custom themes."
        )}
      </p>
    </section>
    <section data-part="features">
      <article data-part="feature">
        <span data-part="index">01</span><h2 data-part="title">Write without clutter</h2><p data-part="description">
          Posts, standalone pages, images, feeds, and a focused editor. Nothing between an idea and the page.
        </p>
      </article>
      <article data-part="feature">
        <span data-part="index">02</span><h2 data-part="title">Bring your domain</h2><p data-part="description">
          Use a Gesttalt subdomain or verify any domain you own. Requests are mapped to the right publication automatically.
        </p>
      </article>
      <article data-part="feature">
        <span data-part="index">03</span><h2 data-part="title">Publish from anywhere</h2><p data-part="description">
          Connect a mobile app, an automation, or an agent through the <a href="https://oauth.net/2/">OAuth 2.0 authorization framework</a>, the application programming interface, or the <a href="https://modelcontextprotocol.io/">Model Context Protocol</a>.
        </p>
      </article>
    </section>
    <section data-part="manifesto">
      <p data-part="eyebrow">Themes are code</p><h2 data-part="title">
        Standard design variables. Liquid route templates. A live conversational loop.
      </h2><p data-part="description">
        Describe the change to your agent, keep the live preview beside the conversation, and publish the isolated draft only when it feels right.
      </p><a href={~p"/docs#themes"}>Read the theme guide →</a>
    </section>
  </div>
</Layouts.app>
