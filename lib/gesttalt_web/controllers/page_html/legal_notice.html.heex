<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="legal-notice">
    <.legal_document
      draft={false}
      eyebrow={dgettext("legal", "Provider information")}
      title={dgettext("legal", "Legal notice")}
      description={
        dgettext(
          "legal",
          "Information about the person responsible for operating Gesttalt and how to contact them."
        )
      }
    >
      <section data-part="section">
        <h2 data-part="title">{dgettext("legal", "Individual service provider")}</h2>
        <dl data-part="facts">
          <dt>{dgettext("legal", "Name")}</dt><dd>Pedro Piñera Buendía</dd>
          <dt>{dgettext("legal", "Trading as")}</dt><dd>Gesttalt</dd>
          <dt>{dgettext("legal", "Legal form")}</dt><dd>
            {dgettext("legal", "Sole proprietor, not a separate legal entity")}
          </dd>
          <dt>{dgettext("legal", "Serviceable address")}</dt><dd>
            <address>
              Jessnerstrasse 27a<br /> 10247 Berlin<br /> Germany
            </address>
          </dd>
        </dl>
      </section>

      <section data-part="section">
        <h2 data-part="title">{dgettext("legal", "Contact")}</h2>
        <dl data-part="facts">
          <dt>{dgettext("legal", "Email")}</dt><dd>
            <a href="mailto:gesttalt@pepicrft.me">gesttalt@pepicrft.me</a>
          </dd>
        </dl>
      </section>

      <section data-part="section">
        <h2 data-part="title">{dgettext("legal", "Digital service contacts")}</h2>
        <p>
          Customers, authorities, the European Commission, and the European Board for Digital
          Services may contact <a href="mailto:gesttalt@pepicrft.me">gesttalt@pepicrft.me</a>. Communication is accepted
          in English. Notices about specific potentially illegal content may also be submitted
          through the <a href={~p"/report-illegal-content"}>electronic reporting form</a>.
        </p>
      </section>

      <section data-part="section">
        <h2 data-part="title">{dgettext("legal", "Customer publications")}</h2>
        <p>
          Each customer controls and is responsible for the content of their own publication,
          including any provider, editorial, privacy, or other disclosures required for that
          publication. Gesttalt remains responsible for the platform and for reports submitted
          through its reporting route.
        </p>
      </section>

      <section data-part="section">
        <h2 data-part="title">{dgettext("legal", "Consumer dispute resolution")}</h2>
        <p>
          Gesttalt is neither willing nor obliged to participate in dispute-resolution proceedings
          before a consumer arbitration board. The former European online dispute-resolution
          platform was discontinued and is not used.
        </p>
      </section>
    </.legal_document>
  </div>
</Layouts.app>
