<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="subscription-cancellation">
    <.legal_document
      draft={false}
      eyebrow={dgettext("legal", "Ongoing subscriptions")}
      title={dgettext("legal", "Cancel a subscription")}
      description={
        dgettext(
          "legal",
          "Cancellation ends future renewal of an ongoing paid subscription. Gesttalt is currently free during early access."
        )
      }
    >
      <section data-part="section">
        <h2 data-part="title">{dgettext("legal", "No paid subscription to cancel")}</h2>
        <p>
          Gesttalt does not currently offer or renew paid subscriptions, does not request payment
          details, and does not charge an early-access account. There is therefore no paid
          subscription to cancel.
        </p>
      </section>

      <section data-part="section">
        <h2 data-part="title">{dgettext("legal", "Stop using Gesttalt")}</h2>
        <p>
          You may stop using the service at any time. To permanently remove your account,
          publication, connected applications, and uploaded media, use the deletion control in <a href={
            ~p"/users/settings"
          }>account settings</a>. Encrypted backups expire within 30
          days. Account deletion cannot be undone.
        </p>
      </section>

      <section data-part="section">
        <h2 data-part="title">{dgettext("legal", "Future paid plans")}</h2>
        <p>
          Before any paid consumer subscription is offered, this page will provide the direct
          electronic cancellation process and immediate confirmation required by German law. It
          will remain available without requiring access to the customer dashboard.
        </p>
        <p>
          If you believe a payment or subscription is associated with your account, contact <a href="mailto:gesttalt@pepicrft.me">gesttalt@pepicrft.me</a>.
        </p>
      </section>
    </.legal_document>
  </div>
</Layouts.app>
